ALLEGRO_EMAIL=your_email@example.com
ALLEGRO_PASSWORD=your_password_here

# === Browser fingerprint ===
# These three MUST match each other AND the Chrome that exported your cookies.
# Get them from chrome://version  (User Agent line)
# and DevTools > Network > any request > Request Headers (sec-ch-ua, sec-ch-ua-platform).
#
# IMPORTANT QUOTING RULES for python-dotenv:
#   - User-Agent has no special chars  -> NO surrounding quotes.
#   - sec-ch-ua contains commas, semicolons, and inner quotes
#     -> WRAP THE WHOLE VALUE IN SINGLE QUOTES so inner double quotes survive.
#   - sec-ch-ua-platform must keep its inner quotes (header value is literally "Windows")
#     -> WRAP IN SINGLE QUOTES.
#
# Example for Chrome 147 on Windows:
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.0.0 Safari/537.36
BROWSER_SEC_CH_UA='"Google Chrome";v="147", "Not.A/Brand";v="8", "Chromium";v="147"'
BROWSER_SEC_CH_UA_PLATFORM='"Windows"'

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

HEADLESS=false

# === Throttling (humanlike pacing) ===
# Random delay (seconds) between processed rows. 2-4s is a good default.
ROW_DELAY_MIN=2.0
ROW_DELAY_MAX=4.0

# Every N rows, take a longer break to simulate a human pausing.
# Set LONG_PAUSE_EVERY_N_ROWS=0 to disable.
LONG_PAUSE_EVERY_N_ROWS=100
LONG_PAUSE_MIN=20.0
LONG_PAUSE_MAX=45.0
